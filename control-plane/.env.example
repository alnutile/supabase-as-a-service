# SupaNet control plane — provisioning credentials.
# Copy to .env (gitignored). Every var here is org-powerful: never commit, never
# ship to a browser, never move into the main app's env.

# --- Supabase Management API (Sundance Solutions org) ---
# PAT: https://supabase.com/dashboard/account/tokens
SUPANET_MGMT_PAT=
# Org id (slug) tenant projects are created under: `supabase orgs list`
SUPANET_ORG_ID=
# Region for tenant projects
TENANT_REGION=us-east-1

# --- Railway (per-tenant app services) ---
# Account/team token: https://railway.com/account/tokens
RAILWAY_TOKEN=
# The Railway project + environment that will hold tenant services
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
# GitHub repo + branch tenant services deploy from
TENANT_REPO=OWNER/REPO
RELEASE_BRANCH=release

# --- Cloudflare (tenant subdomains on supanet.io) ---
# API token scoped to Zone:DNS:Edit on the supanet.io zone
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
TENANT_DOMAIN=supanet.io

# --- OpenRouter (per-tenant AI keys) ---
# Provisioning key: https://openrouter.ai/settings/provisioning-keys
OPENROUTER_PROVISIONING_KEY=
# Monthly spend limit per tenant key, USD (allowance + buffer; raise on plan change)
TENANT_OPENROUTER_LIMIT_USD=15

# --- Control-plane Supabase (the supanet-control project itself) ---
# Where tenants/provisioning_jobs live; the worker and edge functions use it.
CONTROL_PLANE_SUPABASE_URL=
CONTROL_PLANE_SERVICE_ROLE_KEY=

# --- Stripe (slice 3; test keys until launch) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
