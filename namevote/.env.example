# Copy to .env for local dev, or set these as Railway variables.

# Required: the shared password everyone types to get in.
APP_PASSWORD=change-me

# Required: server-side Anthropic key (never exposed to the browser).
ANTHROPIC_API_KEY=sk-ant-...

# Recommended: keeps logins valid across restarts/deploys. Any long random string.
SESSION_SECRET=

# Optional overrides.
# ANTHROPIC_MODEL=claude-opus-4-8
# ANTHROPIC_EFFORT=medium          # low | medium | high | max
# DATABASE_PATH=./data/namevote.db # point at a mounted volume on Railway to persist
# PORT=3000
