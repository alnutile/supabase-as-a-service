# Copy to infra/.env and fill in. Used by docker-compose for local worker dev.
# The SAME variables are set as Railway (or any provider) service variables in
# production — that's the portability boundary.

# Required — your Supabase project.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key (server-side only — NEVER ship to the browser).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — sensible defaults shown.
STORAGE_BUCKET=files
POLL_INTERVAL_MS=3000
JOB_LEASE_SECONDS=120
MAX_ATTEMPTS=3
LOG_LEVEL=info
