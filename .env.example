# Copy to .env.local and fill in. These are exposed to the browser (anon key is safe by design — RLS protects data).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Server-side only (set as Supabase Edge Function secrets, NOT here) ---
# supabase secrets set OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_API_KEY=
# Optional overrides:
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5   # fallback when a model_profiles row can't be read
# OPENROUTER_EFFORT=medium                        # low | medium | high (reasoning effort)
# OPENROUTER_SITE_URL=https://your-app.example    # optional ranking header (HTTP-Referer)
# OPENROUTER_APP_NAME=Intranet In A Box           # optional ranking header (X-Title)
