# Copy to .env.local and fill in. These are exposed to the browser (anon key is safe by design — RLS protects data).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Server-side only (set as Supabase Edge Function secrets, NOT here) ---
# supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
